{
  "name": "copilot-provider",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --fix",
    "lint-yolo": "biome check --fix --allow-unsafe",
    "dev": "bun run serve --hot",
    "build": "bun run scripts/build.ts",
    "start": "bun run build && bun src/index.ts",
    "serve": "bun run build && bun src/index.ts --watch"
  },
  "packageManager": "bun@1.3.5",
  "devDependencies": {
    "@types/bun": "^1.3.11"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.8",
    "@ai-sdk/provider-utils": "^4.0.21",
    "@github/copilot-sdk": "^0.2.0",
    "ai": "^6.0.141",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  }
}
