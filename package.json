{
	"bugs": {
		"url": "https://github.com/patgpt/copilot-provider/issues"
	},
	"dependencies": {
		"@ai-sdk/provider": "^3.0.8",
		"@ai-sdk/provider-utils": "^4.0.21",
		"@github/copilot-sdk": "^0.2.0"
	},
	"description": "AI SDK provider that routes text generation through the GitHub Copilot SDK.",
	"devDependencies": {
		"@biomejs/biome": "2.4.9",
		"@types/bun": "^1.3.11",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"typescript": "^5.9.3",
		"ultracite": "7.4.0"
	},
	"engines": {
		"bun": ">=1.3.5",
		"node": ">=18"
	},
	"exports": {
		".": {
			"default": "./dist/index.js",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/**/*",
		"README.md",
		"ISSUES.md"
	],
	"homepage": "https://github.com/patgpt/copilot-provider#readme",
	"keywords": [
		"ai",
		"ai-sdk",
		"copilot",
		"github-copilot",
		"provider",
		"vercel-ai-sdk"
	],
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
			"bun x ultracite fix"
		]
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"name": "copilot-provider",
	"packageManager": "bun@1.3.5",
	"peerDependencies": {
		"ai": "^6.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/patgpt/copilot-provider.git"
	},
	"scripts": {
		"build": "bun run scripts/build.ts",
		"check": "bun run lint && bun run typecheck && bun test",
		"check:all": "bun run check && bun run build && bun run example:build",
		"clean": "bun run scripts/build.ts --clean-only",
		"dev": "bun --watch run scripts/build.ts",
		"example:build": "bun run example/build.ts",
		"example:dev": "bun --hot example/src/index.ts",
		"lint": "bunx biome check .",
		"lint:fix": "bunx biome check --write .",
		"prepare": "husky",
		"prepublishOnly": "bun run check:all",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"typecheck": "bunx tsc -p tsconfig.json --noEmit"
	},
	"sideEffects": false,
	"type": "module",
	"types": "./dist/index.d.ts",
	"version": "0.0.1"
}
